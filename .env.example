# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# ---------------------------------------------------------------------------

# --- Django core ---
DJANGO_SECRET_KEY=change-me-in-production-please   # REQUIRED (non-default) when DJANGO_DEBUG=False
DJANGO_DEBUG=True                                  # True for local dev, False in production
DJANGO_ALLOWED_HOSTS=                              # comma-separated hostnames, required when DEBUG=False
SECURE_SSL_REDIRECT=True                           # (prod) redirect http->https
SECURE_HSTS_SECONDS=31536000                       # (prod) HSTS max-age
COMPANY_EMAIL_DOMAIN=stemzglobal.com               # only employees with this domain may register
# --- Anthropic / Claude ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL_FAST=claude-haiku-4-5-20251001        # high-confidence retrieval
CLAUDE_MODEL_DEFAULT=claude-sonnet-5               # balanced default
CLAUDE_MODEL_ESCALATION=claude-opus-4-8            # low-confidence, deeper reasoning
FAST_SCORE_THRESHOLD=0.7
ESCALATION_SCORE_THRESHOLD=0.3

# --- Retrieval / RAG ---
SIM_THRESHOLD=0.05
TOP_K=8

# --- Admin dashboard (HTTP basic auth on /dashboard/) ---
ADMIN_USER=admin
ADMIN_PASSWORD=change-me                            # REQUIRED (non-default) when DJANGO_DEBUG=False

# --- Email (Ask HR escalation) — Gmail SMTP with a Workspace app password ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=you@example.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_FROM=you@example.com
EMAIL_TO_HR=hr@example.com                          # where Ask HR requests land

# --- Whisper (voice-to-text) ---
WHISPER_MODEL=small                                 # tiny | base | small | medium | large-v3
WHISPER_COMPUTE_TYPE=int8                           # int8 (fast CPU) | float16 (GPU)
WHISPER_DEVICE=cpu                                  # cpu | cuda
WHISPER_MAX_AUDIO_MB=25
